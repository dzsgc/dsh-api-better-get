{
  "name": "dsh-moonshot-models",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "让 DSH「获取可用模型」对 Moonshot 走真实 GET /v1/models，而不是读内置静态目录",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
